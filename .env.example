# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint) ---
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen2.5:7b-instruct
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...   LLM_MODEL=gpt-4o-mini
# Other:   any server exposing /v1/chat/completions
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.1
# true = let the LLM call tools itself; false = intent router picks the tool, LLM only phrases the answer
LLM_TOOL_CALLING=false

# --- Neo4j knowledge graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=anchorai-dev

# --- Data ---
ANCHORAI_DATA_DIR=SystemCode/data
ANCHORAI_SEED=42

# --- App database ---
# Defaults to <ANCHORAI_DATA_DIR>/app.db. Set only to override; relative sqlite paths are from the repo root.
# ANCHORAI_DB_URL=sqlite:///SystemCode/data/app.db

# --- Auth ---
# Generate one with: openssl rand -hex 32
ANCHORAI_JWT_SECRET=change-me-to-a-random-32-byte-hex-string
ANCHORAI_JWT_TTL_MINUTES=720
# Password for the seeded demo users (admin, manager, staff1, staff2)
ANCHORAI_DEMO_PASSWORD=anchorai
