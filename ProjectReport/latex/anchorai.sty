\newcommand{\badge}[2]{\tikz[baseline=(b.base)]\node(b)[fill=#1, rounded corners=1.5pt,
  inner xsep=3pt, inner ysep=1.6pt, font=\sffamily\bfseries\scriptsize, text=white]{#2};}
\newcommand{\databadge}[1]{\ifstrequal{#1}{real}{\badge{nusBlue}{REAL DATA}}{\badge{nusOrange}{SCENARIO LAYER}}}
\newcommand{\vdot}[1]{\tikz[baseline=-0.6ex]\fill[#1] (0,0) circle (2.3pt);}
\newcommand{\verdict}[1]{{\sffamily\bfseries
  \ifstrequal{#1}{met}{\vdot{cGreen}\,\textcolor{cGreen}{Met}}{%
  \ifstrequal{#1}{partly}{\vdot{nusOrange}\,\textcolor{nusOrange}{Partly met}}{%
  \vdot{cRed}\,\textcolor{cRed}{Not met}}}}}

