% Charts: one style for every plot; colours keep one meaning across the report
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}
\pgfplotsset{compat=1.18}
% Chart numbers are set in text mode, so they take the sans font, with a true minus sign
\newcommand{\axisnum}[2][]{\pgfmathprintnumberto[assume math mode=true,#1]{#2}{\axisnum@tmp}\expandafter\axisnum@fix\axisnum@tmp\relax}
\def\axisnum@fix#1#2\relax{\ifx-#1\textminus#2\else#1#2\fi}
\usepgfplotslibrary{groupplots,fillbetween}
\usetikzlibrary{positioning,arrows.meta,calc,patterns,shapes.geometric,backgrounds,fit}
\pgfplotsset{
  anchor/.style={
    width=\linewidth, height=5cm,
    axis lines*=left, axis line style={draw=muted!60, line width=0.5pt},
    tick style={draw=muted!60, line width=0.5pt}, major tick length=2pt,
    tick label style={font=\sffamily\scriptsize, text=muted},
    label style={font=\sffamily\footnotesize, text=ink},
    title style={font=\sffamily\footnotesize\bfseries, text=nusBlue},
    ymajorgrids, grid style={draw=rule!70, line width=0.3pt},
    legend style={draw=none, fill=none, font=\sffamily\scriptsize, text=ink},
    legend cell align=left,
    every axis plot/.append style={line width=1.2pt},
    scaled ticks=false, xticklabel={\axisnum{\tick}}, yticklabel={\axisnum{\tick}},
    /pgf/number format/.cd, 1000 sep={,},
  },
  anchorbar/.style={anchor, ybar, bar width=7pt, enlarge x limits=0.15, area legend,
    every axis plot/.append style={draw=none, line width=0pt}},
  anchorhbar/.style={anchor, xbar, ymajorgrids=false, xmajorgrids, bar width=6pt, area legend,
    every axis plot/.append style={draw=none, line width=0pt}},
}
\pgfplotsset{/pgfplots/area legend/.style={legend image code/.code={\fill[##1, draw=none] (0cm,-0.07cm) rectangle (0.32cm,0.11cm);}}}
\newcommand{\results}[1]{../../SystemCode/notebooks/results/#1}
